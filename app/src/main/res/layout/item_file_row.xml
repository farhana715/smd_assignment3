<?xml version="1.0" encoding="utf-8"?>
<!-- item_file_row.xml – row for the Files ListView in FilesFragment -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Thumbnail / icon -->
    <ImageView
        android:id="@+id/iv_file_thumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_attachment"
        android:scaleType="centerCrop"
        android:contentDescription="attachment thumbnail" />

    <!-- Name + type -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="filename.png"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_file_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Image"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Preview button -->
    <Button
        android:id="@+id/btn_preview"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_button_teal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Preview"
        android:textColor="@color/text_white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Remove icon -->
    <TextView
        android:id="@+id/tv_remove_file"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:text="🗑"
        android:textSize="18sp" />

</LinearLayout>
